<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud">

    <Button
        android:id="@+id/high_score_BTN_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Menu"
        android:textSize="14sp"
        android:backgroundTint="@color/dark_blue"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:elevation="4dp"
        android:translationZ="4dp"/>

    <androidx.fragment.app.FragmentContainerView
    android:id="@+id/high_score_FRAME_list"
    android:name="com.example.cardodge.utilities.ScoreListFragment"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="8dp"
    app:layout_constraintTop_toBottomOf="@id/high_score_BTN_back"
    app:layout_constraintBottom_toTopOf="@id/high_score_FRAME_map"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/high_score_FRAME_map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/high_score_FRAME_list"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>